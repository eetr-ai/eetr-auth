{
	"name": "@eetr/auth",
	"version": "0.6.0",
	"description": "OAuth 2.1 and OpenID Connect authorization server for Cloudflare Workers",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build --webpack",
		"start": "next start",
		"lint": "eslint . && node ../../scripts/check-theme.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"deploy": "opennextjs-cloudflare build -c wrangler.generated.jsonc && SKIP_WRANGLER_CONFIG_CHECK=yes opennextjs-cloudflare deploy -c wrangler.generated.jsonc",
		"deploy:infra": "npm run deploy",
		"upload": "opennextjs-cloudflare build -c wrangler.generated.jsonc && opennextjs-cloudflare upload -c wrangler.generated.jsonc",
		"preview": "opennextjs-cloudflare build -c wrangler.generated.jsonc && opennextjs-cloudflare preview -c wrangler.generated.jsonc",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@eetr/react-reducer-utils": "^0.1.1",
		"@opennextjs/cloudflare": "^1.20.14",
		"@scalar/nextjs-api-reference": "^0.12.14",
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.0.3",
		"jose": "^6.2.13",
		"lucide-react": "^1.64.0",
		"md5": "^2.3.0",
		"next": "16.4.3",
		"next-auth": "^5.0.0-beta.32",
		"qrcode.react": "^4.2.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"resend": "^6.35.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-next": "16.4.3",
		"strip-json-comments": "^5.0.1",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.7.4",
		"vitest": "^5.0.5",
		"wrangler": "^4.155.0"
	}
}
