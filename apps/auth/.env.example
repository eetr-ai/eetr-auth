# Auth.js (next-auth). Required for session encryption.
# The checked-in dev default is fine for local work; replace it in shared or real environments.
AUTH_SECRET=changeme-local-auth-secret

# Password hashing. Defaults to "argon" (Argon2 via the ARGON_HASHER binding), which local
# dev does not run — so opt local into the unsalted MD5 fallback. Never use md5 in production
# (HASH_METHOD=md5 is refused when NODE_ENV=production).
HASH_METHOD=md5

# Resend (transactional email: MFA, password reset). Set in production via wrangler secret put RESEND_API_KEY
RESEND_API_KEY=

# JWT (local dev): run npm run jwt:generate-local-cert to set JWT_PRIVATE_KEY, JWT_KID, and JWT_JWKS_JSON
# in .env.local. Verification uses JWT_JWKS_JSON so next dev works (R2 in next dev is separate from wrangler --local).

# Optional prefix for generated OAuth client IDs: <prefix>_<24 random chars>.
# Defaults to "eetr" when unset.
CLIENT_KEY_PREFIX=eetr
