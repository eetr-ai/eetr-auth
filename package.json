{
  "name": "eetr-auth-monorepo",
  "version": "0.3.1",
  "private": true,
  "workspaces": [
    "apps/auth",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/auth",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "deploy:argon-hasher": "cd apps/argon-hasher && npx wrangler deploy",
    "deploy:auth": "npm run deploy --workspace=apps/auth",
    "deploy": "npm run deploy:argon-hasher && npm run deploy:auth",
    "setup:local:env": "cd apps/auth && node ../../scripts/setup-local-dev.mjs",
    "setup:local": "npm run setup:local:env && npm run db:schema && npm run db:seed-local-admin",
    "setup:remote": "cd apps/auth && node ../../scripts/setup-remote.mjs",
    "upgrade:remote": "cd apps/auth && node ../../scripts/upgrade-remote.mjs",
    "db:schema": "cd apps/auth && node ../../scripts/run-d1-migrate.mjs --local --file=../../db/schema.sql",
    "db:schema:remote": "cd apps/auth && node ../../scripts/run-d1-migrate.mjs --remote --file=../../db/schema.sql",
    "db:migrate": "cd apps/auth && node ../../scripts/run-d1-migrate.mjs --local",
    "db:migrate:remote": "cd apps/auth && node ../../scripts/run-d1-migrate.mjs --remote",
    "db:bootstrap": "npm run db:schema && npm run db:schema:remote",
    "db:create-admin": "cd apps/auth && node ../../scripts/create-admin.mjs",
    "db:create-admin:local": "cd apps/auth && node ../../scripts/create-admin.mjs --local-only",
    "db:create-admin:remote": "cd apps/auth && node ../../scripts/create-admin.mjs --remote-only",
    "db:set-site-url": "cd apps/auth && node ../../scripts/set-site-url.mjs",
    "db:set-site-url:local": "cd apps/auth && node ../../scripts/set-site-url.mjs --local-only",
    "db:set-site-url:remote": "cd apps/auth && node ../../scripts/set-site-url.mjs --remote-only",
    "db:create-user": "npm run db:create-admin --",
    "db:create-user:local": "npm run db:create-admin:local --",
    "db:create-user:remote": "npm run db:create-admin:remote --",
    "db:seed-local-admin": "cd apps/auth && node ../../scripts/seed-local-admin.mjs",
    "db:seed-remote-admin": "cd apps/auth && node ../../scripts/seed-remote-admin.mjs",
    "setup:hmac-key": "bash scripts/setup-hmac-key.sh",
    "jwt:setup-secrets": "cd apps/auth && node ../../scripts/setup-jwt-secrets.mjs",
    "jwt:generate-local-cert": "cd apps/auth && node ../../scripts/generate-local-jwt-cert.mjs",
    "verify": "cd apps/auth && node ../../scripts/verify-setup.mjs --local",
    "verify:remote": "cd apps/auth && node ../../scripts/verify-setup.mjs --remote",
    "infra:prepare-config": "npm run infra:terraform-output && npm run infra:render-wrangler",
    "infra:validate:setup": "cd apps/auth && node ../../scripts/validate-remote-setup.mjs --mode clean-install",
    "infra:validate:upgrade": "cd apps/auth && node ../../scripts/validate-remote-setup.mjs --mode upgrade",
    "infra:terraform-output": "cd apps/auth && node ../../scripts/terraform-output.mjs",
    "infra:render-wrangler": "cd apps/auth && node ../../scripts/render-wrangler-config.mjs --base ../../infra/wrangler.template.jsonc --tf-json ../../infra/out/terraform.tf.json",
    "infra:provision": "cd apps/auth && node ../../scripts/provision-env.mjs"
  }
}
