{
  "name": "@eetr/eetr-auth-client",
  "version": "0.5.3",
  "description": "TypeScript client library for eetr-auth OAuth 2.1 / OIDC server",
  "license": "MIT",
  "author": "eetr-ai",
  "homepage": "https://github.com/eetr-ai/eetr-auth/tree/main/packages/eetr-auth-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eetr-ai/eetr-auth.git",
    "directory": "packages/eetr-auth-client"
  },
  "bugs": {
    "url": "https://github.com/eetr-ai/eetr-auth/issues"
  },
  "keywords": [
    "oauth",
    "oauth2",
    "oidc",
    "openid-connect",
    "authentication",
    "passkeys",
    "webauthn",
    "eetr-auth"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "@types/node": "^26.6.5",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
